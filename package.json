{
  "name": "discdeck",
  "version": "0.3.7",
  "description": "DiscDeck Decky plugin for physical discs, read-only filesystem images, and Redumper preservation",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:py": "PYTHONPATH=py_modules:. python3 -m unittest discover -s tests -t .",
    "package": "python3 scripts/package_plugin.py --output out",
    "verify:zip": "python3 scripts/verify_zip.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zany130/DiscDeck.git"
  },
  "keywords": [
    "discdeck",
    "decky",
    "plugin",
    "optical"
  ],
  "author": "zany130",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/zany130/DiscDeck/issues"
  },
  "homepage": "https://github.com/zany130/DiscDeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "eslint": "9.39.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "8.18.0",
    "vitest": "2.1.9"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
